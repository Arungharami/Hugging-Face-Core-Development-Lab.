# Hugging Face Core Development Lab - Environment Variables Template
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit your real .env file or real HF_TOKEN to version control!

# Hugging Face User Access Token (Read/Write depending on operations)
# Generate token at: https://huggingface.co/settings/tokens
HF_TOKEN=replace_with_your_hugging_face_token

# Hugging Face Username or Organization Name
HF_USERNAME=arun-gharami

# Environment Setting (development, testing, production)
ENV=development

# Optional: Default Hub Cache Directory
# HF_HOME=~/.cache/huggingface
